# Google Sheets API Configuration
# Get these from Google Cloud Console > Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Your Google Spreadsheet ID (from the URL: /spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Admin password for the backend dashboard
ADMIN_PASSWORD=changeme123

# Base URL (update for production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
